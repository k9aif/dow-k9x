@startuml 02-orchestration-class-diagram
title DAS orchestration: an orchestrator knows only squads

package "k9_aif_abb (K9-AIF framework)" {
  abstract class BaseOrchestrator {
    +execute_flow(payload) : dict
  }
  class SquadLoader {
    +load_one(yaml_file, squad_id) : BaseSquad
    +from_agents(...)
  }
}

package "k9_dow.orchestrators" {
  class ProcessStageOrchestrator {
    #squads : SquadLoader
    #_load_squad(yaml_file, squad_id)
    #_run_squad(squad, name, payload)
    +prepare_gate(gate_id, payload, prior)
    +publish_review(gate_id, job_id, readiness)
    +run_package(payload, run, approved_gate, gate_id)
    +resume_context(payload, approved_gate, earlier_runs)
    +hold_for_governance(job_id, run, ...)
  }
  class RequirementOrchestrator {
    run: requirement
    gate: SERVICE-VALIDATION (+ JCI-REVIEW)
  }
  class MsaOrchestrator {
    runs: mdd_package, msa
    gates: MDD, MILESTONE-A
  }
  class TmrrOrchestrator {
    run: tmrr
    gate: SE-REVIEW-SRR
  }
  class TraceabilityOrchestrator {
    traceability and drift checks
  }
  class ProgressMonitor
}

class "dow_orchestrator_process" as OP <<process>> {
  squads = squad_layer(config)
  consumes the run topics
  topic -> orchestrator
}

BaseOrchestrator <|-- ProcessStageOrchestrator
ProcessStageOrchestrator <|-- RequirementOrchestrator
ProcessStageOrchestrator <|-- MsaOrchestrator
ProcessStageOrchestrator <|-- TmrrOrchestrator
BaseOrchestrator <|-- TraceabilityOrchestrator
ProcessStageOrchestrator --> SquadLoader : squads=
ProcessStageOrchestrator --> ProgressMonitor
OP --> RequirementOrchestrator : das.requirement
OP --> MsaOrchestrator : das.mdd, das.msa
OP --> TmrrOrchestrator : das.tmrr
OP --> TraceabilityOrchestrator : das.traceability

note bottom of ProcessStageOrchestrator
  Loads squads by YAML file and squad id; never names or registers agents.
  Failures: PermissionError -> governance hold; JobWithdrawn -> stop;
  anything else -> stage result status=error (Retry), then re-raise.
end note
@enduml
