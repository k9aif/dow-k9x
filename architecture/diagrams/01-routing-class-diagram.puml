@startuml 01-routing-class-diagram
title DAS routing (process model mca-2026-10)

package "k9_aif_abb (K9-AIF framework)" {
  abstract class BaseRouter {
    +route(payload) : dict
    +admit(payload, credentials) : dict
    +apply_zero_trust(payload)
  }
  class K9EventBus {
    +subscribe_async(handler)
    +publish(event)
  }
}

package "k9_dow" {
  class DasRouter {
    +layer = "DAS Router"
    +route(payload) : dict
  }
  class "dow_router_process" as RP <<process>> {
    consumes dow.router.in
    consumes K9X HIL reply topics (one per gate)
    publishes to the run topics (stamps _topic)
  }
  class "hil_gateway" as HG <<module>> {
    GATE_NEXT_STAGE
    GATE_TOPICS
    approvers()
    save_gate_decision()
    gate_approved_event()
  }
  class "process_model.yaml" as PM <<config>> {
    stages
    gates (entry criteria, authority,
    blocking, approval_starts, hil_queue)
    sources S1-S8
  }
  class "DAS_TOPICS" as T <<topics>> {
    das.requirement
    das.mdd
    das.msa
    das.tmrr
    das.traceability
    das.drift
    das.results
  }
}

BaseRouter <|-- DasRouter
RP --> DasRouter : route()
RP --> K9EventBus
RP --> HG : record decision, build gate_approved
HG --> PM : gate -> next run
DasRouter --> T : event_type / gate_id -> topic

note right of DasRouter
  capability_gap (any document) -> das.requirement
  gate_approved -> the run the gate's approval starts
  JCI-REVIEW -> das.results (decision recorded only)
  SE-REVIEW-SRR -> das.results (flow ends)
  traceability_check -> das.traceability
  drift_check -> das.drift
end note
@enduml
