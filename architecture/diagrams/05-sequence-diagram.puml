@startuml 05-sequence-diagram
title DAS end to end: requirement to System Requirements Review (process model mca-2026-10)

actor "Capability Sponsor" as sponsor
participant "DAS web UI and API\n(app backend)" as api
participant "Docling-Serve" as docling
queue "Job queue\n(SQS-compatible)" as q
queue "Kafka" as kafka
participant "DasRouter\n(router process)" as router
participant "RequirementOrchestrator" as req
participant "MsaOrchestrator" as msa
participant "TmrrOrchestrator" as tmrr
participant "k9x Shield +\nGranite Guardian" as shield
participant "Squads\n(DasSquad)" as squads
database "Object storage\n(stage results by job)" as store
participant "K9X HIL" as hil
actor "Decision authorities" as people

sponsor -> api : upload document (PDF, Word, scan, Markdown)
api -> docling : convert to Markdown (OCR); keep the original
api -> q : enqueue job (queue limits: refuse when full)
q -> api : dispatcher takes one job
api -> kafka : dow.router.in (capability_gap)
kafka -> router : route()
router -> kafka : das.requirement

== Requirement run ==
kafka -> req : execute_flow
req -> shield : screen every section (warnings reported, never a rejection)
req -> squads : ViewGenerationSquad (model elements, DoDAF views)
req -> squads : GateReadinessSquad (verdict per criterion; score in code)
req -> squads : PackageAssemblySquad (Service validation package)
req -> squads : JointReviewSquad (Joint Staffing Designator recommendation)
req -> store : stage result
req -> hil : task SERVICE-VALIDATION (blocking)
req -> hil : task JCI-REVIEW (parallel, never blocks)

people -> hil : approve / reject / return
hil -> kafka : decision on the gate's reply topic
kafka -> router : record decision (immutable); approval -> gate_approved
router -> kafka : das.mdd

== MDD package run ==
kafka -> msa : run mdd_package
msa -> squads : MddPackageSquad (AoA study plan), GateReadiness, PackageAssembly
msa -> hil : task MDD
people -> hil : MDA decides (ADM)
hil -> kafka : decision
kafka -> router : approval
router -> kafka : das.msa

== MSA run ==
kafka -> msa : run msa
msa -> squads : MsaAnalysisSquad (AoA summary, ASR, acquisition strategy), GateReadiness, PackageAssembly
msa -> hil : task MILESTONE-A (cites every earlier decision)
people -> hil : MDA decides (ADM)
hil -> kafka : decision
kafka -> router : approval
router -> kafka : das.tmrr

== TMRR run ==
kafka -> tmrr : run tmrr
tmrr -> squads : SrrPackageSquad (system requirements), GateReadiness, PackageAssembly
tmrr -> hil : task SE-REVIEW-SRR
people -> hil : technical review chair decides
hil -> kafka : decision
kafka -> router : decision recorded; das.results (flow ends)

note over req, tmrr
  Any failed agent ends the stage as a recorded error (Retry); a Shield or Guardian
  refusal mid-stage holds the run and asks K9X HIL; a withdrawn job stops before its next agent.
  An undecided gate task expires after its decision window and is rejected (fail closed).
end note
@enduml
