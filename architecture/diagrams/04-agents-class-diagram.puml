@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 30

title **DoW Architecture Workbench — Agent Layer**\nAll agents extend K9-AIF BaseAgent — use llm_invoke, publish_event

' ── ABB ───────────────────────────────────────────────────

package "K9-AIF Framework (ABB)" #E8F5E9 {

    abstract class BaseAgent <<ABB>> {
        +config: dict
        +monitor
        +message_bus
        +governance
        +logger
        --
        {abstract} +execute(payload: dict): dict
        +publish_event(event: dict)
        +enforce_governance()
    }

    class "llm_invoke(config, req)" as llm <<ABB Utility>> {
        → ModelRouterFactory
        → K9ModelRouter.route()
        → LLMFactory.get()
        → OllamaLLM.invoke()
    }

    abstract class BaseRetriever <<ABB>> {
        {abstract} +retrieve(query, top_k): list
        {abstract} +index(chunks): list
    }
}

' ── SBB: Infrastructure Agents ────────────────────────────

package "DoW Infrastructure Agents" #FFF3E0 {

    class DocumentNormalizationAgent <<SBB>> {
        +layer = "DoW DocNormalization"
        --
        +execute(payload): dict
        -_extract_from_file(path): str
        -_extract_docx(path): str
        -_extract_pdf(path): str
    }

    class ValidationAgent <<SBB>> {
        +layer = "DoW Validation"
        --
        +execute(payload): dict
        .. checks min length, structure ..
    }

    class GovernanceReviewAgent <<SBB>> {
        +layer = "DoW Governance"
        --
        +execute(payload): dict
        .. LLM checks evidence grounding ..
        .. returns pass / warn / block ..
    }

    class VerificationAgent <<SBB>> {
        +layer = "DoW Verification"
        --
        +execute(payload): dict
        .. cross-view consistency ..
    }

    class SummarizerAgent <<SBB>> {
        +layer = "DoW Summarizer"
        --
        +execute(payload): dict
        .. compiles stage report ..
    }
}

' ── SBB: DoDAF Domain Agents ─────────────────────────────

package "DoW DoDAF Domain Agents" #E3F2FD {

