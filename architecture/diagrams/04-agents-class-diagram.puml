@startuml 04-agents-class-diagram
title DAS agents (Solution Building Blocks on K9-AIF ABBs)

package "k9_aif_abb (K9-AIF framework)" {
  abstract class BaseAgent {
    +execute(payload) : dict
    +publish_event(event)
  }
  abstract class K9ValidationLoopAgent {
    generate -> validate -> retry
    +fail()
  }
  class "llm_invoke(config, request)" as LLM <<function>>
}

package "k9_dow.agents" {
  class SectionWriterAgent {
    renders policy mappings (config/mappings)
    and PROCESS_FACTS into the prompt
  }

  package "Package writers" {
    class JsdRecommenderAgent
    class AoaStudyPlanAgent
    class AoaSummaryAgent
    class AlternativeSystemsReviewAgent
    class AcquisitionStrategyAgent
    class SystemRequirementsAgent
  }

  package "Validation-loop agents" {
    class ViewGeneratorAgent
    class LinkProposerAgent
    class DriftClassifierAgent
  }

  package "Architecture views" {
    class ModelExtractorAgent
    class ViewConsistencyCheckerAgent
  }
  package "Gate readiness" {
    class CriteriaLoaderAgent
    class EvidenceCollectorAgent
    class ReadinessScorerAgent
    class GapReporterAgent
  }
  package "Package assembly" {
    class ArtifactFetcherAgent
    class CompletenessCheckerAgent
    class PackageBuilderAgent
  }
  package "Traceability and drift" {
    class LinkValidatorAgent
    class OrphanDetectorAgent
    class CoverageScorerAgent
    class BaselineDifferAgent
    class FundingDifferAgent
  }
}

BaseAgent <|-- K9ValidationLoopAgent
BaseAgent <|-- SectionWriterAgent
SectionWriterAgent <|-- JsdRecommenderAgent
SectionWriterAgent <|-- AoaStudyPlanAgent
SectionWriterAgent <|-- AoaSummaryAgent
SectionWriterAgent <|-- AlternativeSystemsReviewAgent
SectionWriterAgent <|-- AcquisitionStrategyAgent
SectionWriterAgent <|-- SystemRequirementsAgent
K9ValidationLoopAgent <|-- ViewGeneratorAgent
K9ValidationLoopAgent <|-- LinkProposerAgent
K9ValidationLoopAgent <|-- DriftClassifierAgent
BaseAgent <|-- ModelExtractorAgent
BaseAgent <|-- ViewConsistencyCheckerAgent
BaseAgent <|-- CriteriaLoaderAgent
BaseAgent <|-- EvidenceCollectorAgent
BaseAgent <|-- ReadinessScorerAgent
BaseAgent <|-- GapReporterAgent
BaseAgent <|-- ArtifactFetcherAgent
BaseAgent <|-- CompletenessCheckerAgent
BaseAgent <|-- PackageBuilderAgent
BaseAgent <|-- LinkValidatorAgent
BaseAgent <|-- OrphanDetectorAgent
BaseAgent <|-- CoverageScorerAgent
BaseAgent <|-- BaselineDifferAgent
BaseAgent <|-- FundingDifferAgent
BaseAgent ..> LLM : every agent except\nCriteriaLoader and ArtifactFetcher

note bottom of ReadinessScorerAgent
  The model gives a verdict per entry criterion;
  the score is computed in code from the verdicts
  and the gate's criterion weights (gates/readiness.py).
end note
@enduml
