' ── SBB: Retriever ───────────────────────────────────────

package "DoW Retriever" #E8F5E9 {

    class DowRetriever <<SBB>> {
        -_vector_store
        -_catalog_adapter
        --
        +retrieve(query, top_k): list
        +index(chunks): list
    }

    DowRetriever --|> BaseRetriever
}

' ── Inheritance ──────────────────────────────────────────

DocumentNormalizationAgent --|> BaseAgent
ValidationAgent --|> BaseAgent
GovernanceReviewAgent --|> BaseAgent
VerificationAgent --|> BaseAgent
SummarizerAgent --|> BaseAgent

StakeholderExtractorAgent --|> BaseAgent
PainPointExtractorAgent --|> BaseAgent
ObjectiveExtractorAgent --|> BaseAgent
MissionAssessmentAgent --|> BaseAgent
F2PIntentAgent --|> BaseAgent
ProjectScopeAgent --|> BaseAgent
CapabilityExtractorAgent --|> BaseAgent
DM2ExtractorAgent --|> BaseAgent
DataCorrelationAgent --|> BaseAgent
ArchitectureAnalyzerAgent --|> BaseAgent
ReportWriterAgent --|> BaseAgent

' ── Usage ────────────────────────────────────────────────

StakeholderExtractorAgent ..> llm : llm_invoke
CapabilityExtractorAgent ..> llm : llm_invoke
DM2ExtractorAgent ..> llm : llm_invoke
CapabilityExtractorAgent ..> DowRetriever : governed context
DM2ExtractorAgent ..> DowRetriever : governed context

note bottom of CapabilityExtractorAgent
    **DoDAF 2.0 expert prompts:**
    • CAP-001 ID format
    • CV-2/CV-3 semantics
    • Strict evidence grounding
    • Banlist: AI, ML, cloud, etc.
    • "NOT PROVIDED IN SOURCE"
end note

note bottom of DocumentNormalizationAgent
    **No LLM needed:**
    Pure extraction agent.
    .md/.txt → passthrough
    .pdf → pypdf
    .docx → python-docx
    Binary → Docling OCR (optional)
end note

@enduml
