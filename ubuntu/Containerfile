# K9-AIF DAS — Defense Acquisition System
# RHEL UBI 9 Python 3.11 container image
#
# DAS is a K9-AIF SBB — it consumes the framework as the published
# k9-aif[s3] PyPI package (pinned in requirements.txt), not a local
# checkout. No sibling k9-aif-framework directory is needed on the host.
#
# Build (from the directory containing dow-k9-aif):
#   podman build -t k9-aif-das:latest -f dow-k9-aif/ubuntu/Containerfile .

FROM registry.access.redhat.com/ubi9/python-311:latest

# The DAS repo isn't always checked out under the literal name
# "dow-k9-aif" (e.g. cloned as "dow-k9x" from its GitHub remote on some
# hosts) — build-run.sh passes the real directory name here so COPY
# below works regardless of host-specific clone naming.
ARG DAS_SRC_DIR=dow-k9-aif

USER root

RUN dnf install -y --nodocs gcc libpq-devel && dnf clean all

WORKDIR /app

# Install DAS app (pulls k9-aif[s3] from PyPI per requirements.txt)
COPY ${DAS_SRC_DIR}/requirements.txt /tmp/das-requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r /tmp/das-requirements.txt

COPY ${DAS_SRC_DIR}/ /app/dow-k9-aif/

# COPY runs as root, so anything the app needs to write at runtime (e.g.
# runtime/k9_aif_state.db, runtime/k9_model_router.db — SQLite persistence
# state) is otherwise unwritable by the non-root runtime user below. UID
# 1001 has no reliable identity here, only group-root membership, matching
# the arbitrary-UID convention RHEL/OpenShift base images expect (same
# fix satan's Containerfile already has for its own data dir).
RUN chown -R 1001:0 /app/dow-k9-aif && chmod -R g+rwX /app/dow-k9-aif

WORKDIR /app/dow-k9-aif

ENV PYTHONPATH=/app/dow-k9-aif/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    K9_ENV=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" \
      || exit 1

USER 1001

CMD ["uvicorn", "k9_dow.api.app:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--log-level", "info"]
