[Unit]
Description=K9-AIF DAS — k9-dow-pod (3-container Podman pod)
Documentation=https://das.k9x.ai
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DAS_DEPLOY_DIR=/home/ravinata/ai/das-dev-pod-deployment

# Deploy through build-run.sh so .env values (OLLAMA_MODEL, OLLAMA_HOST, host IP, login settings)
# are rendered into the pod spec. Playing ubuntu/das-pod.yaml directly would start the pod with
# its literal <OLLAMA_MODEL>/<PODMAN_HOST_IP> placeholders.
ExecStart=/bin/bash ${DAS_DEPLOY_DIR}/dow-k9-aif/ubuntu/build-run.sh up
ExecStop=/bin/bash ${DAS_DEPLOY_DIR}/dow-k9-aif/ubuntu/build-run.sh down

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
