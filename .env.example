K9_DOW_ENV=local
DEMO_MODE=OFF
K9_DOW_ACTIVE_LLM=ollama
OLLAMA_HOST=http://localhost:11434
# Model for every DAS agent (general, reasoning, package_synthesis) and what the UI/ICD report
OLLAMA_MODEL=qwen3.8:27b
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
K9_PG_PASSWORD=change-me
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
DOCLING_ENDPOINT=http://localhost:5001/v1/parse
KNOWLEDGE_CORPUS_LABEL=None

# Web login (src/k9_dow/api/auth.py). demo/demo views and runs jobs; the admin
# also starts the next stage after a K9X HIL approval. No admin password = no admin.
DAS_DEMO_USER=demo
DAS_DEMO_PASSWORD=demo
DAS_ADMIN_USER=admin
DAS_ADMIN_PASSWORD=
DAS_SESSION_SECRET=
# manual (default): HIL approval is recorded, DAS admin starts the next stage
# from Jobs in Pipeline. auto: the approval starts it immediately.
DAS_RESUME_MODE=manual

# Independent grader for generated documents (Generated Docs → Quality check)
GRADER_MODEL=deepseek-r1:32b
